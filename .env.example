# Flask session signing key. Replace this with a long random value.
FLASK_SECRET_KEY=change-this-to-a-long-random-secret

# Local MongoDB. MongoDB must be installed and running before signup/login.
MONGO_URI=mongodb://127.0.0.1:27017/moviesuggest
MONGO_DATABASE=moviesuggest

# TMDB credentials: use either a v3 API key or the API Read Access Token.
# The API Read Access Token is sent only by the backend as a Bearer token.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Optional Google OAuth. Leave blank until a Google Web OAuth client exists.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Keep false for local http://127.0.0.1 development.
SESSION_COOKIE_SECURE=false
